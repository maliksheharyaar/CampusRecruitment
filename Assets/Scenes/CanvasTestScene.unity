  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.9528302, g: 0.93934673, b: 0.93934673, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 585188cdc4600544eb408bee749e4b3a, type: 3}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 1
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.92
  m_Text: "The Bachelor of Commerce (Honours Business Administration) at the University
    of Windsor\u2019s Odette School of Business is a four-year undergraduate program
    that provides a comprehensive foundation in all key areas of business\u200B\n\n.
    Students experience a blend of classroom learning, faculty interaction, and hands-on
    activities like case studies, group projects, and community engagement\u200B\n\n.
    The program offers both co-operative (co-op) and non-co-op streams, as well as
    an optional thesis for those interested in research\u200B\n\n. In the first two
    years, all BComm students take a broad range of core business courses; in third
    year, you can choose a specialization to focus your studies in a particular field\u200B\n\n.
    By graduation, students are well-prepared with a strong business foundation and
    practical skills, ready to enter the workforce or pursue further education."
